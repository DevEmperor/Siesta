{
  "manifest_version": 3,
  "name": "Siesta – Unload Idle Tabs",
  "short_name": "Siesta",
  "version": "1.1.0",
  "description": "Unloads tabs you haven't used for a while, with a timer per tab or per site. Overview, settings and stats right in the popup.",
  "author": "DevEmperor",
  "homepage_url": "https://github.com/DevEmperor/Siesta",
  "icons": {
    "48": "icons/siesta.svg",
    "96": "icons/siesta.svg"
  },
  "permissions": ["tabs", "storage", "alarms", "sessions", "menus"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Siesta",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/toolbar-dark.svg",
    "theme_icons": [
      { "light": "icons/toolbar-light.svg", "dark": "icons/toolbar-dark.svg", "size": 16 },
      { "light": "icons/toolbar-light.svg", "dark": "icons/toolbar-dark.svg", "size": 32 }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "siesta@devemperor.net",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
